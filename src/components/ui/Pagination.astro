---
export interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;

const isPrevDisabled = currentPage === 1;
const isNextDisabled = currentPage === lastPage;
---

<nav
  class="flex items-center justify-between gap-4 my-8"
  aria-label="Pagination navigation"
>
  <!-- Previous Button -->
  {
    isPrevDisabled ? (
      <button
        disabled
        class="px-4 py-2 rounded glass text-frost/40 cursor-not-allowed font-inter text-sm"
        aria-disabled="true"
      >
        ← Previous
      </button>
    ) : (
      <a
        href={prevUrl}
        class="px-4 py-2 rounded glass hover:border-neon-cyan/50 hover:bg-dark-surface/60 text-frost hover:text-neon-cyan transition-all font-inter text-sm focus-ring"
        aria-label="Go to previous page"
      >
        ← Previous
      </a>
    )
  }

  <!-- Page Indicator -->
  <div class="text-center font-inter text-sm text-frost/70">
    Page <span class="font-semibold text-neon-cyan">{currentPage}</span> of
    <span class="font-semibold text-frost">{lastPage}</span>
  </div>

  <!-- Next Button -->
  {
    isNextDisabled ? (
      <button
        disabled
        class="px-4 py-2 rounded glass text-frost/40 cursor-not-allowed font-inter text-sm"
        aria-disabled="true"
      >
        Next →
      </button>
    ) : (
      <a
        href={nextUrl}
        class="px-4 py-2 rounded glass hover:border-neon-cyan/50 hover:bg-dark-surface/60 text-frost hover:text-neon-cyan transition-all font-inter text-sm focus-ring"
        aria-label="Go to next page"
      >
        Next →
      </a>
    )
  }
</nav>
