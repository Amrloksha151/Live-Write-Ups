---
type Difficulty = 'beginner' | 'intermediate' | 'advanced' | 'expert';

export interface Props {
  difficulty: Difficulty;
}

const { difficulty } = Astro.props;

const badgeStyles: Record<Difficulty, { bg: string; text: string; border: string }> = {
  beginner: { bg: 'rgba(0, 255, 0, 0.1)', text: '#00FF00', border: '#00FF00' },
  intermediate: { bg: 'rgba(0, 255, 255, 0.1)', text: '#00FFFF', border: '#00FFFF' },
  advanced: { bg: 'rgba(255, 0, 255, 0.1)', text: '#FF00FF', border: '#FF00FF' },
  expert: { bg: 'rgba(255, 102, 0, 0.1)', text: '#FF6600', border: '#FF6600' },
};

const styles = badgeStyles[difficulty];
const capitalizedDifficulty = difficulty.charAt(0).toUpperCase() + difficulty.slice(1);
---

<span
  class="inline-block px-3 py-1 rounded-full text-xs font-inter font-semibold border"
  style={`background-color: ${styles.bg}; color: ${styles.text}; border-color: ${styles.border};`}
>
  {capitalizedDifficulty}
</span>
