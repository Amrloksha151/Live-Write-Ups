---
type Difficulty = 'beginner' | 'intermediate' | 'advanced' | 'expert';

export interface Props {
  difficulty: Difficulty;
}

const { difficulty } = Astro.props;

const badgeStyles: Record<Difficulty, { bg: string; text: string }> = {
  beginner: { bg: '#d1fae5', text: '#065f46' },
  intermediate: { bg: '#fef3c7', text: '#92400e' },
  advanced: { bg: '#fee2e2', text: '#991b1b' },
  expert: { bg: '#2B2D42', text: '#EDF2F4' },
};

const styles = badgeStyles[difficulty];
const capitalizedDifficulty = difficulty.charAt(0).toUpperCase() + difficulty.slice(1);
---

<span
  class="inline-block px-3 py-1 rounded-full text-xs font-dm font-semibold"
  style={`background-color: ${styles.bg}; color: ${styles.text};`}
>
  {capitalizedDifficulty}
</span>
