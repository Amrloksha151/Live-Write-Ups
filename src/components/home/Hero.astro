---
---

<section class="relative min-h-[60vh] bg-space flex items-center justify-center">
  <!-- Decorative grid background -->
  <div
    class="absolute inset-0 opacity-5"
    style="background-image: linear-gradient(0deg, transparent 24%, rgba(239, 35, 60, 0.05) 25%, rgba(239, 35, 60, 0.05) 26%, transparent 27%, transparent 74%, rgba(239, 35, 60, 0.05) 75%, rgba(239, 35, 60, 0.05) 76%, transparent 77%, transparent); background-size: 50px 50px;"
  >
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center md:text-left">
    <!-- Overline -->
    <p class="text-xs md:text-sm font-syne font-bold text-crimson uppercase tracking-widest mb-4">
      Live Write Ups
    </p>

    <!-- Headline -->
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-syne font-extrabold text-snow mb-4 leading-tight">
      Read the hack.<br class="hidden md:block" /> Learn the thinking.
    </h1>

    <!-- Subheading -->
    <p class="text-base md:text-lg text-slate max-w-2xl mx-auto md:mx-0 mb-8 font-dm leading-relaxed">
      Cybersecurity write-ups that emphasize decision-making. Discover not just <span class="text-crimson font-semibold"
        >what</span
      > was done, but <span class="text-crimson font-semibold">why</span> it was done at every critical juncture.
    </p>

    <!-- CTA Button -->
    <a
      href="#writeups"
      class="inline-block px-6 py-3 bg-crimson text-snow font-dm font-semibold rounded hover:bg-scarlet transition-colors focus-ring"
    >
      Browse Write-ups
    </a>
  </div>

  <!-- Decorative accent line -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-crimson to-transparent opacity-20">
  </div>
</section>
