---
import LucideIcon from '../ui/LucideIcon.astro';

export interface Props {
  term: string;
  definition: string;
}

const { term, definition } = Astro.props;
---

<span class="knowledge-note group relative inline-block cursor-help border-b border-dotted border-neon-cyan/50 hover:border-neon-cyan transition-colors">
  <slot />
  <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 w-64 -translate-x-1/2 scale-95 rounded-lg glass-lg border border-frost/20 bg-dark-bg/95 p-3 text-xs opacity-0 shadow-2xl transition-all group-hover:pointer-events-auto group-hover:scale-100 group-hover:opacity-100 z-50">
    <div class="flex items-center gap-2 mb-1 text-neon-cyan font-display font-bold uppercase tracking-wider">
      <LucideIcon name="info" class="w-3 h-3" />
      <span>{term}</span>
    </div>
    <p class="text-frost/90 font-inter leading-relaxed">{definition}</p>
    <div class="absolute top-full left-1/2 -mt-1 -translate-x-1/2 border-8 border-transparent border-t-dark-bg/95"></div>
  </span>
</span>

<style>
  .knowledge-note {
    text-decoration: none;
  }
</style>
