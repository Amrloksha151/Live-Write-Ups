---
export interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<span
  class="inline-block px-2.5 py-1 bg-dark-surface/40 text-frost text-xs font-inter font-semibold rounded-full border border-neon-green/40 hover:border-neon-green/80 hover:bg-dark-surface/60 lg:hover:shadow-lg lg:hover:shadow-neon-green/20 transition-all"
>
  {tag}
</span>
