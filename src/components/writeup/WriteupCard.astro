---
import { Image } from 'astro:assets';
import { withBase } from '../../lib/url';
import TagPill from './TagPill.astro';
import Badge from '../ui/Badge.astro';

export interface Props {
  title: string;
  description: string;
  author: string;
  publishedAt: Date;
  tags: string[];
  difficulty: 'beginner' | 'intermediate' | 'advanced' | 'expert';
  slug: string;
  coverImage?: any;
}

const { title, description, author, publishedAt, tags, difficulty, slug, coverImage } = Astro.props;

// Format date
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(publishedAt);

// Get author initials for avatar
const initials = author
  .split(' ')
  .map((n) => n[0])
  .join('')
  .toUpperCase()
  .slice(0, 2);
---

<a
  href={withBase(`/writeups/${slug}/stage/1`)}
  class="group block rounded-lg glass glass-lg overflow-hidden hover:shadow-lg hover:shadow-neon-cyan/20 hover:border-neon-cyan/50 transition-all duration-300 hover:translate-y-[-2px] focus-ring"
>
  {
    coverImage && (
      <div class="relative w-full aspect-video overflow-hidden bg-dark-surface/30 rounded-t-lg">
        <Image
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
        />
      </div>
    )
  }

  <div class="p-4 flex flex-col gap-3">
    <!-- Tags (max 3) -->
    {tags.length > 0 && (
      <div class="flex gap-2 flex-wrap">
        {tags.slice(0, 3).map((tag) => (
          <TagPill tag={tag} />
        ))}
        {tags.length > 3 && (
          <span class="text-xs text-frost/60 font-inter">+{tags.length - 3}</span>
        )}
      </div>
    )}

    <!-- Title -->
    <h3 class="text-lg font-display font-bold text-frost line-clamp-2">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm text-frost/70 font-inter line-clamp-2">
      {description}
    </p>

    <!-- Footer: Author, Date, Difficulty -->
    <div class="flex items-center justify-between pt-3 border-t border-frost/10">
      <div class="flex items-center gap-2">
        <!-- Author Avatar Placeholder -->
        <div class="w-8 h-8 rounded-full bg-neon-cyan/20 flex items-center justify-center">
          <span class="text-xs font-inter font-bold text-neon-cyan">
            {initials}
          </span>
        </div>
        <div class="flex flex-col gap-0">
          <span class="text-xs font-inter font-semibold text-frost">
            {author}
          </span>
          <span class="text-xs text-frost/50 font-inter">
            {formattedDate}
          </span>
        </div>
      </div>

      <!-- Difficulty Badge -->
      <Badge difficulty={difficulty} />
    </div>
  </div>
</a>
