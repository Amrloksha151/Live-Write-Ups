---
import TagPill from './TagPill.astro';
import Badge from '../ui/Badge.astro';
import LucideIcon from '../ui/LucideIcon.astro';

export interface Props {
  title: string;
  author: string;
  publishedAt: Date;
  updatedAt?: Date;
  readingTime?: number;
  tags: string[];
  difficulty: 'beginner' | 'intermediate' | 'advanced' | 'expert';
  platform: string;
  category: string;
}

const {
  title,
  author,
  publishedAt,
  updatedAt,
  readingTime,
  tags,
  difficulty,
  platform,
  category,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedAt);

const formattedUpdatedDate = updatedAt
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedAt)
  : null;
---

<header class="mb-12 pb-8 border-b border-frost/10">
  <!-- Title -->
  <h1 data-reveal style="transition-delay: 0.05s; text-shadow: 0 0 30px rgba(0, 255, 255, 0.3);" class="text-4xl md:text-5xl font-display font-bold text-frost mb-6">
    {title}
  </h1>

  <!-- Metadata Row -->
  <div data-reveal style="transition-delay: 0.1s" class="flex flex-wrap items-center gap-3 text-sm font-inter text-frost/80 mb-6"> 
    <!-- Author -->
    <span>By <span class="font-semibold text-frost">{author}</span></span>
    <span class="text-frost/40">·</span>

    <!-- Publish Date -->
    <span>{formattedDate}</span>
    {
      formattedUpdatedDate && (
        <>
          <span class="text-frost/40">·</span>
          <span class="flex items-center gap-1">
            <LucideIcon name="refresh-cw" class="w-3 h-3" />
            Updated {formattedUpdatedDate}
          </span>
        </>
      )
    }

    <!-- Reading Time -->
    {
      readingTime && (
        <>
          <span class="text-frost/40">·</span>
          <span class="flex items-center gap-1">
            <LucideIcon name="clock" class="w-3 h-3" />
            {readingTime} min read
          </span>
        </>
      )
    }
  </div>

  <!-- Meta Pills -->
  <div data-reveal style="transition-delay: 0.2s" class="flex flex-wrap gap-2 mb-6"> 
    <!-- Platform -->
    <span class="px-3 py-1 rounded-full bg-dark-surface/50 border border-frost/20 text-frost text-xs font-inter font-semibold">
      {platform}
    </span>

    <!-- Category -->
    <span class="px-3 py-1 rounded-full bg-neon-magenta/20 border border-neon-magenta/50 text-neon-magenta text-xs font-inter font-semibold">
      {category}
    </span>

    <!-- Difficulty -->
    <Badge difficulty={difficulty} />
  </div>

  <!-- Tags -->
  {
    tags.length > 0 && (
      <div data-reveal style="transition-delay: 0.3s" class="flex flex-wrap gap-2"> 
        {tags.map((tag) => (
          <TagPill tag={tag} />
        ))}
      </div>
    )
  }
</header>
