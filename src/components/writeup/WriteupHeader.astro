---
import TagPill from './TagPill.astro';
import Badge from '../ui/Badge.astro';
import LucideIcon from '../ui/LucideIcon.astro';

export interface Props {
  title: string;
  author: string;
  publishedAt: Date;
  updatedAt?: Date;
  readingTime?: number;
  tags: string[];
  difficulty: 'beginner' | 'intermediate' | 'advanced' | 'expert';
  platform: string;
  category: string;
}

const {
  title,
  author,
  publishedAt,
  updatedAt,
  readingTime,
  tags,
  difficulty,
  platform,
  category,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedAt);

const formattedUpdatedDate = updatedAt
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedAt)
  : null;
---

<header class="mb-12 pb-8 border-b border-snow/10">
  <!-- Title -->
  <h1 class="text-4xl md:text-5xl font-syne font-bold text-snow mb-6">
    {title}
  </h1>

  <!-- Metadata Row -->
  <div class="flex flex-wrap items-center gap-3 text-sm font-dm text-snow mb-6">
    <!-- Author -->
    <span>By <span class="font-semibold text-snow">{author}</span></span>
    <span class="text-snow/40">·</span>

    <!-- Publish Date -->
    <span>{formattedDate}</span>
    {
      formattedUpdatedDate && (
        <>
          <span class="text-snow/40">·</span>
          <span class="flex items-center gap-1">
            <LucideIcon name="refresh-cw" class="w-3 h-3" />
            Updated {formattedUpdatedDate}
          </span>
        </>
      )
    }

    <!-- Reading Time -->
    {
      readingTime && (
        <>
          <span class="text-snow/40">·</span>
          <span class="flex items-center gap-1">
            <LucideIcon name="clock" class="w-3 h-3" />
            {readingTime} min read
          </span>
        </>
      )
    }
  </div>

  <!-- Meta Pills -->
  <div class="flex flex-wrap gap-2 mb-6">
    <!-- Platform -->
    <span class="px-3 py-1 rounded-full bg-snow/15 text-snow text-xs font-dm font-semibold">
      {platform}
    </span>

    <!-- Category -->
    <span class="px-3 py-1 rounded-full bg-crimson text-snow text-xs font-dm font-semibold">
      {category}
    </span>

    <!-- Difficulty -->
    <Badge difficulty={difficulty} />
  </div>

  <!-- Tags -->
  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <TagPill tag={tag} />
        ))}
      </div>
    )
  }
</header>
