---
import Base from '../layouts/Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import HomePage from '../components/home/HomePage.astro';
import { getPublishedWriteups, paginateWriteups } from '../lib/writeups';

const writeups = await getPublishedWriteups();
const { pageItems, currentPage, totalPages, prevUrl, nextUrl } = paginateWriteups(writeups, 1);
---

<Base
	title="Live Write Ups"
	description="Free cybersecurity write-ups focused on decision-making, not just commands."
>
	<Navbar />
	<main>
		<HomePage
			writeups={pageItems}
			currentPage={currentPage}
			lastPage={totalPages}
			prevUrl={prevUrl}
			nextUrl={nextUrl}
		/>
	</main>
	<Footer />
</Base>
