---
/**
 * [slug].astro
 * 
 * Deprecated: This route has been replaced by the stage-based system.
 * Redirects /writeups/{slug} to /writeups/{slug}/stage/1
 */

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups', ({ data }) => !data.draft);
  
  return writeups.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;

// Redirect to the first stage
return Astro.redirect(`/writeups/${slug}/stage/1`);
