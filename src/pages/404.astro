---
import Base from '../layouts/Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import LucideIcon from '../components/ui/LucideIcon.astro';
import { withBase } from '../lib/url';
---

<Base title="404 - Page Not Found" description="The page you're looking for doesn't exist.">
  <Navbar />
  <main class="flex-1 flex items-center justify-center px-4 py-20 md:py-32">
    <div class="max-w-md text-center">
      <!-- Error Code -->
      <h1 class="text-9xl md:text-10xl font-display font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-neon-magenta to-neon-orange mb-6">
        404
      </h1>

      <!-- Error Message -->
      <h2 class="text-4xl md:text-5xl font-display font-bold text-frost mb-4">
        Page Not Found
      </h2>
      <p class="text-frost/70 font-inter text-lg mb-8 leading-relaxed">
        The write-up you're looking for has been lost to the void. It might have been removed, renamed, or never existed at all.
      </p>

      <!-- Error Details -->
      <div class="mb-8 p-4 rounded-lg bg-dark-surface/20 border border-slate/20">
        <p class="text-sm font-space-mono text-neon-cyan/80" id="path-display">
          <span class="text-slate/60">Path:</span> <span id="requested-path">{Astro.url.pathname}</span>
        </p>
      </div>

      <script>
        // Display the actual requested path instead of the 404 page path
        const pathSpan = document.getElementById('requested-path');
        if (pathSpan) {
          pathSpan.textContent = window.location.pathname;
        }
      </script>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={withBase('/')}
          class="px-6 py-3 bg-neon-cyan text-dark-bg rounded font-display font-bold hover:bg-neon-green transition-all duration-300 hover:scale-105 focus-ring"
        >
          Back to Home
        </a>
        <a
          href={withBase('/#writeups')}
          class="px-6 py-3 bg-dark-surface/40 text-frost border border-slate/30 rounded font-display font-bold hover:border-neon-cyan/50 hover:bg-dark-surface/60 transition-all duration-300 hover:scale-105 focus-ring"
        >
          Browse Write-ups
        </a>
      </div>

      <!-- Help Text -->
      <p class="mt-8 text-frost/50 font-inter text-sm">
        If you believe this is a mistake, please <a href="https://github.com/Amrloksha151/Live-Write-Ups/issues" target="_blank" rel="noopener noreferrer" class="text-neon-cyan hover:underline">report an issue</a>.
      </p>
    </div>
  </main>
  <Footer />
</Base>
